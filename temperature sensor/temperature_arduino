#include <Wire.h>
#include <SparkFun_TMP117.h>
#include <WiFiNINA.h>
#include <WiFiUdp.h>

// --- IMPOSTAZIONI DI RETE ---
const char* SSID = "Arianna";        
const char* PASSWORD = "ariannaa";   
const char* PC_IP = "10.207.94.246"; // L'IP del PC che riceve i dati
const int UDP_PORT = 5005;

WiFiUDP udp;

// --- IMPOSTAZIONI SENSORE ---
TMP117 sensor;
const unsigned long sampleInterval = 100; // 10Hz (una lettura ogni 100ms)
unsigned long lastSampleTime = 0;

void setup() {
  Serial.begin(115200);
  Wire.begin();

  // Inizializza il sensore TMP117
  if (sensor.begin() == false) {
    Serial.println("Errore: Sensore TMP117 non trovato!");
    while (1); // Blocca l'esecuzione se il sensore non è presente
  }

  // Connessione al Wi-Fi
  Serial.print("Connessione in corso a: ");
  Serial.println(SSID);
  
  WiFi.begin(SSID, PASSWORD);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("\nConnesso! IP Board: ");
  Serial.println(WiFi.localIP());

  // Inizializza il protocollo UDP
  udp.begin(UDP_PORT);
}

void loop() {
  unsigned long currentSampleTime = millis();

  // Mantenimento della frequenza di campionamento
  if (currentSampleTime - lastSampleTime >= sampleInterval) {
    lastSampleTime += sampleInterval;

    // Controlla se il dato è pronto
    if (sensor.dataReady() == true) {
      float tempC = sensor.readTempC();

      // Invia pacchetto UDP
      udp.beginPacket(PC_IP, UDP_PORT);
      
      // Formato CSV: "tempo,temperatura"
      udp.print(currentSampleTime);
      udp.print(",");
      udp.println(tempC, 4); // 4 decimali per alta precisione
      
      udp.endPacket();

      // Debug opzionale su seriale
      // Serial.println(tempC); 
    }
  }
}