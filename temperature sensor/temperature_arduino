#include <Wire.h>
#include <SparkFun_TMP117.h>

// --- IMPOSTAZIONI SENSORE ---
TMP117 sensor;
const unsigned long sampleInterval = 100; // 10Hz (una lettura ogni 100ms)
unsigned long lastSampleTime = 0;

void setup() {
  // Inizializza la comunicazione seriale USB a 115200 baud
  Serial.begin(115200);
  while (!Serial) {
    ; // Attendi l'apertura della porta seriale (necessario su alcune schede come Arduino Nano 33 IoT/UNO WiFi)
  }

  Wire.begin();

  // Inizializza il sensore TMP117
  if (sensor.begin() == false) {
    Serial.println("Errore: Sensore TMP117 non trovato!");
    while (1); // Blocca l'esecuzione se il sensore non è presente
  }

  // Intestazione CSV (opzionale, utile se importi i dati in Excel o Python)
  Serial.println("Tempo_ms,Temperatura_C");
}

void loop() {
  unsigned long currentSampleTime = millis();

  // Mantenimento della frequenza di campionamento
  if (currentSampleTime - lastSampleTime >= sampleInterval) {
    lastSampleTime += sampleInterval;

    // Controlla se il dato è pronto
    if (sensor.dataReady() == true) {
      float tempC = sensor.readTempC();

      // Invia i dati al PC tramite USB in formato CSV: "tempo,temperatura"
      Serial.print(currentSampleTime);
      Serial.print(",");
      Serial.println(tempC, 4); // 4 decimali per alta precisione
    }
  }
}