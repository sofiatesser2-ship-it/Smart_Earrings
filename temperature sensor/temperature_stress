import serial
import time
import csv  # <--- NUOVO: Modulo per la gestione dei file CSV

# --- CONFIGURAZIONI SERIALE ---
PORTA_SERIALE = "COM5"
BAUD_RATE = 9600

# Soglie fisiologiche stimate
SOGLIA_STRESS = 31.5
SOGLIA_RILASSAMENTO = 34.0
NOME_FILE_CSV = "temperature_data.csv"  # <--- NUOVO: Nome del file di output

def avvia_acquisizione_seriale():
    # Lista vuota per memorizzare i dati in memoria durante l'esecuzione
    dati_raccolti = []  # <--- NUOVO
    
    ser = None
    try:
        # Inizializza la connessione seriale
        ser = serial.Serial(PORTA_SERIALE, BAUD_RATE, timeout=1)
        
        # Pausa di 2 secondi per il reset dell'Arduino
        time.sleep(2)
        
        print(f"Lettura Seriale avviata sulla porta {PORTA_SERIALE} a {BAUD_RATE} baud...")
        print("In attesa di dati dall'Arduino MKR WiFi 1010...")
        print("-" * 60)
        print(f"Soglia Stress (Freddo): < {SOGLIA_STRESS} °C")
        print(f"Soglia Rilassamento (Caldo): > {SOGLIA_RILASSAMENTO} °C\n")
        print("-" * 60)

        # Svuota il buffer iniziale
        ser.reset_input_buffer()

        while True:
            if ser.in_waiting > 0:
                linea = ser.readline().decode('utf-8').strip()
                
                if not linea or "," not in linea:
                    continue
                    
                parti = linea.split(',')
                
                if len(parti) == 2:
                    try:
                        timestamp = int(parti[0])
                        temperatura = float(parti[1])
                        
                        # Logica Stress/Rilassamento
                        if temperatura < SOGLIA_STRESS:
                            stato = "SOTTO STRESS (Vasocostrizione)"
                        elif temperatura > SOGLIA_RILASSAMENTO:
                            stato = "RILASSATO (Vasodilatazione)"
                        else:
                            stato = "NORMALE"
                        
                        # Stampa i dati a video
                        print(f"[COM5] Tempo: {timestamp/1000:>6.1f} s | Temp: {temperatura:06.4f} °C | Stato: {stato}")
                        
                        # NUOVO: Aggiunge la riga corrente alla lista dei dati raccolti
                        dati_raccolti.append([timestamp, temperatura, stato])
                        
                    except ValueError:
                        pass

    except serial.SerialException as e:
        print(f"\nErrore di connessione seriale: {e}")
    except KeyboardInterrupt:
        print("\n\nAcquisizione interrotta dall'utente.")
        
        # NUOVO: Logica di salvataggio su file CSV al momento dell'interruzione
        if dati_raccolti:
            print(f"Salvataggio di {len(dati_raccolti)} record in corso...")
            try:
                with open(NOME_FILE_CSV, mode='w', newline='', encoding='utf-8') as file:
                    writer = csv.writer(file)
                    
                    # Scrive l'intestazione delle colonne (Header)
                    writer.writerow(["Timestamp (ms)", "Temperatura (C)", "Stato Fisiologico"])
                    
                    # Scrive tutte le righe accumulate
                    writer.writerows(dati_raccolti)
                    
                print(f"🏆 File '{NOME_FILE_CSV}' salvato con successo nella cartella corrente!")
            except Exception as e:
                print(f"Errore durante il salvataggio del file CSV: {e}")
        else:
            print("Nessun dato raccolto. Il file CSV non è stato creato.")
            
    finally:
        # Chiude la porta seriale in modo sicuro
        if ser and ser.is_open:
            ser.close()
            print("Connessione seriale chiusa correttamente.")

if __name__ == '__main__':
    avvia_acquisizione_seriale()