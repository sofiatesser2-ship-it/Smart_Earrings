import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Sklearn: Preprocessing, Metriche e Validazione
from sklearn.model_selection import train_test_split, cross_val_score, StratifiedKFold, TimeSeriesSplit
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score
from sklearn.preprocessing import LabelEncoder
from sklearn.pipeline import Pipeline
from sklearn.inspection import permutation_importance 
from sklearn.utils.class_weight import compute_class_weight

# Modelli
from sklearn.ensemble import RandomForestClassifier
from lightgbm import LGBMClassifier

# Ottimizzazione
import optuna

# VARIABILI GLOBALI 
SEED = 356
TRAIN_FILE_PATH = 'features_extraction_binary.csv'
TEST_FILE_PATH = 'features_extraction_acquisizioni.csv'
FEATURES = ['BPM', 'RMSSD', 'SDNN', 'PNN50', 'SD1', 'SD2', 'LF_HF']
GROUP_COL = 'Subject' 

# ==========================================
# PARTE 1: FUNZIONI COMUNI MODIFICATE
# ==========================================

def load_and_prepare_train_data(file_path):
    """Carica e prepara i dati per il training (WESAD)."""
    df = pd.read_csv(file_path).dropna()
    
    # DISTINZIONE BINARIA: Teniamo solo Stress e Baseline
    df = df[df['Label'].isin(['Stress', 'Baseline'])]
    
    X_train = df[FEATURES]
    y_train = df['Label']
    
    # NB: Se 'Subject' non esiste nel file delle acquisizioni, lo teniamo solo qui per tracciamento interno
    groups_train = df[GROUP_COL] if GROUP_COL in df.columns else None 

    # CALCOLO PESI CLASSI
    classes = np.unique(y_train)
    weights = compute_class_weight(class_weight='balanced', classes=classes, y=y_train)
    weights_dict = dict(zip(classes, weights))

    print(f"--- DATI DI TRAINING ({file_path}) ---")
    print(f"Classi rilevate: {classes}")
    print(f"Pesi calcolati per bilanciamento:\n{weights_dict}\n")
    
    return X_train, y_train, groups_train, weights_dict


def load_and_prepare_test_data(file_path):
    """Carica e prepara i dati per il test set indipendente (Acquisizioni)."""
    df = pd.read_csv(file_path).dropna()
    
    # Applichiamo lo stesso filtro binario del training
    df = df[df['Label'].isin(['Stress', 'Baseline'])]
    
    X_test = df[FEATURES]
    y_test = df['Label']
    
    print(f"--- DATI DI TEST INDIPENDENTE ({file_path}) ---")
    print(f"Campioni estratti per il test: {len(df)}")
    print(f"Distribuzione classi nel test:\n{y_test.value_counts()}\n")
    
    return X_test, y_test


def plot_importance(clf, X_test, y_test, model_name):
    plt.figure(figsize=(9, 6))
    importances = None
    names = FEATURES

    if hasattr(clf, 'feature_importances_'):
        importances = clf.feature_importances_
    else:
        result = permutation_importance(clf, X_test, y_test, n_repeats=5, random_state=SEED)
        importances = result.importances_mean

    indices = np.argsort(importances)
    plt.barh(range(len(importances)), importances[indices], color='steelblue', edgecolor='black')
    plt.yticks(range(len(importances)), [names[i] for i in indices])
    plt.title(f'Feature Importance: {model_name}')
    plt.xlabel('Punteggio Importanza')
    plt.grid(axis='x', linestyle='--', alpha=0.6)
    plt.tight_layout()
    plt.show()


def evaluate_model(clf, X_test, y_test, model_name="Modello", label_encoder=None):
    y_pred = clf.predict(X_test)
    if label_encoder is not None:
        y_pred_labels = label_encoder.inverse_transform(y_pred)
        # Controllo se y_test è già stringhe o codificato numericamente
        y_test_labels = y_test if isinstance(y_test.iloc[0], str) else label_encoder.inverse_transform(y_test)
        classes = label_encoder.classes_
    else:
        y_pred_labels = y_pred
        y_test_labels = y_test
        classes = clf.classes_ if hasattr(clf, 'classes_') else np.unique(y_test)
    
    acc = accuracy_score(y_test_labels, y_pred_labels)
    print(f"\n--- PERFORMANCE SUL NUOVO TEST SET: {model_name} (Acc: {acc:.4f}) ---")
    print(classification_report(y_test_labels, y_pred_labels))

    plt.figure(figsize=(6, 4))
    cm = confusion_matrix(y_test_labels, y_pred_labels)
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=classes, yticklabels=classes)
    plt.title(f'Matrice di Confusione: {model_name}')
    plt.ylabel('Effettivo (Acquisizioni)')
    plt.xlabel('Predetto')
    plt.show()

    plot_importance(clf, X_test, y_test, model_name)

# ==========================================
# PARTE 2: TRAINING DEI MODELLI (Invariato)
# ==========================================

def train_random_forest(X_train, y_train, weights_dict):
    print("\n[Optuna] Inizio ottimizzazione Random Forest...")
    
    def objective(trial):
        param = {
            'n_estimators': trial.suggest_int('n_estimators', 50, 300),
            'max_depth': trial.suggest_int('max_depth', 3, 20),
            'min_samples_split': trial.suggest_int('min_samples_split', 2, 10),
            'criterion': trial.suggest_categorical('criterion', ['gini', 'entropy']),
            'class_weight': weights_dict,
            'random_state': SEED,
            'n_jobs': -1
        }
        
        clf = RandomForestClassifier(**param)
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
        score = cross_val_score(clf, X_train, y_train, cv=cv, scoring='f1_macro').mean()
        return score

    study = optuna.create_study(direction='maximize')
    study.optimize(objective, n_trials=50)

    print(f"Migliori parametri RF: {study.best_params}")
    
    best_clf = RandomForestClassifier(**study.best_params, class_weight=weights_dict, random_state=SEED)
    best_clf.fit(X_train, y_train)
    return best_clf


def train_lightgbm(X_train, y_train, weights_dict):
    print("\n[Optuna] Inizio ottimizzazione LightGBM...")
    le = LabelEncoder()
    y_train_encoded = le.fit_transform(y_train)
    
    def objective(trial):
        param = {
            'num_leaves': trial.suggest_int('num_leaves', 20, 100),
            'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.3, log=True),
            'n_estimators': trial.suggest_int('n_estimators', 50, 200),
            'class_weight': 'balanced',
            'random_state': SEED, 
            'n_jobs': -1, 
            'verbose': -1
        }
        clf = LGBMClassifier(**param)
        
        # CAMBIATO DA TimeSeriesSplit A StratifiedKFold per coerenza
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
        
        score = cross_val_score(clf, X_train, y_train_encoded, cv=cv, scoring='f1_macro').mean()
        return score

    study = optuna.create_study(direction='maximize')
    study.optimize(objective, n_trials=50)
    
    print(f"Migliori parametri LightGBM: {study.best_params}")
    
    best_clf = LGBMClassifier(**study.best_params, class_weight='balanced', random_state=SEED, verbose=-1)
    best_clf.fit(X_train, y_train_encoded)
    return best_clf, le

# ==========================================
# PARTE 3: ESECUZIONE AGGIORNATA
# ==========================================

if __name__ == "__main__":
    # 1. CARICAMENTO SEPARATO DEI FILE
    # Training Set da WESAD (100% dei dati filtrati, senza split artificiali)
    X_train, y_train, groups_train, weights_vector = load_and_prepare_train_data(TRAIN_FILE_PATH)
    
    # Test Set dalle tue nuove acquisizioni reali
    X_test, y_test = load_and_prepare_test_data(TEST_FILE_PATH)
    
    # 2. ADDESTRAMENTO MODELLI (Sui dati WESAD)
    # Random Forest
    rf = train_random_forest(X_train, y_train, weights_vector)
    evaluate_model(rf, X_test, y_test, "Random Forest")
    
    # LightGBM
    lgb, le_lgb = train_lightgbm(X_train, y_train, weights_vector)
    evaluate_model(lgb, X_test, y_test, "LightGBM", le_lgb)

    # ==========================================
    # CONFRONTO FINALE (Sulle Nuove Acquisizioni)
    # ==========================================
    print("\n" + "="*50)
    print("SINTESI FINALE DELLE PERFORMANCE SULLE NUOVE ACQUISIZIONI")
    print("="*50)

    final_scores = {
        "Random Forest": accuracy_score(y_test, rf.predict(X_test)),
        "LightGBM": accuracy_score(y_test, le_lgb.inverse_transform(lgb.predict(X_test)))
    }

    # Ordino i modelli dal migliore al peggiore
    sorted_models = dict(sorted(final_scores.items(), key=lambda item: item[1], reverse=True))

    # Creazione del grafico di confronto
    plt.figure(figsize=(8, 5))
    bars = plt.bar(sorted_models.keys(), sorted_models.values(), color=['#4C72B0', '#55A868'])

    # Percentuali sopra le barre
    for bar in bars:
        yval = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2, yval + 0.01, f'{yval:.2%}', ha='center', fontweight='bold')

    plt.title('Confronto Accuratezza su Dati di Acquisizione Esterni', fontsize=12)
    plt.ylabel('Accuracy Score')
    plt.ylim(0, 1.1)
    plt.grid(axis='y', alpha=0.3)
    plt.show()

    # Verdetto finale stampato
    vincitore = list(sorted_models.keys())[0]
    print(f"MODELLO VINCITORE: {vincitore}")
    print(f"Accuratezza raggiunta sulle acquisizioni: {sorted_models[vincitore]:.4f}")
    print("="*50)