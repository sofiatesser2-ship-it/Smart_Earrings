import numpy as np
import pandas as pd
import scipy.stats as stats
import matplotlib.pyplot as plt
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

def calculate_agreement_metrics(y_ref, y_test):
    # Metriche di errore standard
    mae = mean_absolute_error(y_ref, y_test)
    rmse = np.sqrt(mean_squared_error(y_ref, y_test))
    mape = np.mean(np.abs((y_ref - y_test) / y_ref)) * 100
    r2 = r2_score(y_ref, y_test)
    
    # Wilcoxon signed-rank test (per distribuzioni non normali)
    _, p_val = stats.wilcoxon(y_ref, y_test)
    
    # ICC (Interclass Correlation Coefficient) - Approssimazione One-way random effects
    # Per un calcolo preciso dell'ICC(3,1) si consiglia la libreria 'pingouin'
    data_icc = np.stack([y_ref, y_test], axis=1)
    mean_val = np.mean(data_icc)
    sst = np.sum((data_icc - mean_val)**2)
    ssw = np.sum(np.var(data_icc, axis=1, ddof=1) * (2-1))
    icc = (sst - ssw) / sst if sst != 0 else 1.0

    return {"MAE": mae, "RMSE": rmse, "MAPE": mape, "R2": r2, "ICC": icc, "p-value": p_val}

def plot_bland_altman(y_ref, y_test, metric_name):
    mean = (y_ref + y_test) / 2
    diff = y_test - y_ref
    md = np.mean(diff)
    sd = np.std(diff, axis=0)

    plt.figure(figsize=(8, 5))
    plt.scatter(mean, diff, alpha=0.5)
    plt.axhline(md, color='red', linestyle='--', label=f'Bias: {md:.2f}')
    plt.axhline(md + 1.96*sd, color='gray', linestyle=':', label='Upper LoA (1.96 SD)')
    plt.axhline(md - 1.96*sd, color='gray', linestyle=':', label='Lower LoA (1.96 SD)')
    plt.title(f'Bland-Altman Plot: {metric_name}')
    plt.xlabel('Media dei Dispositivi')
    plt.ylabel('Differenza (Earring - Embrace)')
    plt.legend()
    plt.show()

# Esempio d'uso con dati simulati
metrics = ['BPM', 'RMSSD', 'SDNN', 'LF/HF']
results = {}

for m in metrics:
    # Simulazione: y_ref (Embrace), y_test (Earring con noise)
    y_ref = np.random.normal(70, 10, 100) 
    y_test = y_ref + np.random.normal(1, 2, 100) # Aggiunta bias di 1 unità
    
    results[m] = calculate_agreement_metrics(y_ref, y_test)
    plot_bland_altman(y_ref, y_test, m)

# Visualizzazione Risultati
df_results = pd.DataFrame(results).T
print(df_results)

